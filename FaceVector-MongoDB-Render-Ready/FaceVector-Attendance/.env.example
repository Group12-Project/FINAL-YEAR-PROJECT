# Local development: development. Render production: production
NODE_ENV=development
PORT=3000
# Local MongoDB for development; use your Atlas mongodb+srv URI on Render
MONGODB_URI=mongodb://127.0.0.1:27017/facevector
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=8h
# Teachers sign in once per device; the session is renewed automatically while they keep using the app.
TEACHER_JWT_EXPIRES_IN=30d
# Teachers can register themselves on the teacher page. Set to false to require admin-created accounts.
ALLOW_TEACHER_SIGNUP=true
# Optional: if set, teachers must enter this school code to register.
TEACHER_SIGNUP_CODE=
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
# One-time bootstrap is disabled unless explicitly enabled. Use a long random key.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_KEY=replace-with-a-long-one-time-bootstrap-key
# Optional initial campus boundary; it can also be configured in the Admin dashboard.
CAMPUS_NAME=Main campus
CAMPUS_LAT=
CAMPUS_LNG=
CAMPUS_RADIUS_M=
REQUIRE_GEOFENCE=false
GPS_MAX_ACCURACY_M=100
# Euclidean distance thresholds for server-side 128-D descriptor comparison.
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.06
